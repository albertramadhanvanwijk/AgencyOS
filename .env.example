# AgencyOS Environment Variables Example
# Copy this file to .env.local for local overrides. Never commit secrets to source control.

# API Configuration
API_PORT=8000
API_HOST=127.0.0.1
DEBUG=True
ENVIRONMENT=development

# Database Configuration (Defaults to SQLite for local development; use PostgreSQL for production)
DATABASE_URL=sqlite:///./agencyos.db
# DATABASE_URL=postgresql+psycopg://agencyos_user:password@localhost:5432/agencyos_db

# Web Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Workspace Root (Isolated directories for projects and runs)
WORKSPACE_ROOT=./workspaces
